# ==============================================================================
# FOOTBALL BOOKING - EXEMPLE DE CONFIGURATION D'ENVIRONNEMENT
# Copiez ce fichier vers ".env" et remplacez les valeurs par les vôtres.
# NE COMMITEZ JAMAIS LE FICHIER ".env" DANS GIT !
# ==============================================================================

# ── Base de Données PostgreSQL ────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/football_booking?stringtype=unspecified
DB_USER=postgres
DB_PASSWORD=votre_mot_de_passe_securise

# ── Sécurité & Authentification JWT ──────────────────────────────────────────
# Clé secrète robuste pour signer les tokens (min. 32 caractères recommandés)
JWT_SECRET=votre_cle_secrete_jwt_ultra_securisee_2026_changez_moi

# ── Frontend Next.js ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080/football-booking-1.0-SNAPSHOT/api/v1
